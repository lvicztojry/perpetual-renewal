DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
LLM_PROVIDER="compatible"
LLM_API_KEY=""
LLM_BASE_URL="https://api.tryanotherone.com/v1"
LLM_MODEL=""
USER_KEY_VAULT_SECRET=""
SESSION_COOKIE_SECRET=""
PROACTIVE_CRON_SECRET=""

# Optional provider-specific fallbacks. Prefer LLM_API_KEY for provider-neutral config.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_VERSION="2023-06-01"

# Voice can share the LLM gateway. Keep real keys in .env.local or deployment secrets only.
VOICE_PROVIDER="shared-llm"
# Empty voice models fall back to LLM_MODEL when the gateway supports OpenAI-style audio endpoints.
VOICE_STT_MODEL=""
VOICE_TTS_MODEL=""
VOICE_DEFAULT_VOICE="warm"
VOICE_CREDENTIAL_SOURCE="server-env"
