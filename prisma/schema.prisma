generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RelationshipKind {
  REAL_PERSON_SUBSTITUTE
  MEMORIAL
  EX_PARTNER
  LOVER
  FRIEND
  FAMILY
  MENTOR
  PUBLIC_FIGURE_IMAGINED
  FICTIONAL_CHARACTER
  ORIGINAL_CHARACTER
  CUSTOM
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MemoryType {
  USER_FACT
  RELATIONSHIP_EVENT
  COMPANION_PROFILE
  EMOTIONAL_PREFERENCE
}

enum MemoryStatus {
  PENDING
  ACTIVE
  ARCHIVED
  DELETED
}

enum ProactiveMessageStatus {
  DRAFT
  SENT
  DISMISSED
  BLOCKED
}

enum ProactiveMessageKind {
  DAILY_GREETING
  LAST_CONVERSATION_FOLLOWUP
  ANNIVERSARY
  EMOTION_CARE
  PLAYFUL_MISS_YOU
}

enum SafetyEventType {
  SELF_HARM
  HARM_TO_OTHERS
  COERCIVE_ATTACHMENT
  REAL_WORLD_COMMITMENT
  MONEY_OR_LEGAL_IDENTITY
  PUBLIC_FIGURE_AUTHORIZATION
  MINOR_SEXUAL_CONTENT
  PRIVACY_VIOLATION
  PROFESSIONAL_ADVICE
  IDENTITY_DECEPTION
  RELATIONAL_PRESSURE
  SAFETY_OVERRIDE
  OTHER
}

model User {
  id                       String              @id @default(cuid())
  email                    String              @unique
  nickname                 String
  timezone                 String              @default("Asia/Shanghai")
  language                 String              @default("zh-CN")
  proactiveMessagesEnabled Boolean             @default(true)
  proactiveFrequencyHours  Int                 @default(24)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  companions               Companion[]
  conversations            Conversation[]
  memories                 Memory[]
  memoryRevisions          MemoryRevision[]
  relationshipStates       RelationshipState[]
  proactiveMessages        ProactiveMessage[]
  safetyEvents             SafetyEvent[]
  modelUsageLogs           ModelUsageLog[]
  providerCredentials      ProviderCredential[]
  authCredential           AuthCredential?
  authRecoveryTokens       AuthRecoveryToken[]
  dreamWorkspaces          DreamWorkspace[]
  groupWorkspaces          GroupWorkspace[]
  messageReadReceipts      MessageReadReceipt[]
  journey                  UserJourney?
}

model UserJourney {
  userId    String   @id
  revision  Int      @default(0)
  state     Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCredential {
  userId          String   @id
  passwordHash    String
  sessionVersion  String
  emailVerifiedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Pending registration has no User until email proof. Reset also supports legacy users.
model AuthRecoveryToken {
  tokenHash    String   @id
  purpose      String
  userId       String?
  email        String
  nickname     String?
  passwordHash String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([email, purpose])
}

model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model ProactiveSchedulerCheckpoint {
  scope     String   @id
  cursor    String?
  updatedAt DateTime @updatedAt
}

model Companion {
  id                String              @id @default(cuid())
  userId            String
  name              String
  relationshipKind  RelationshipKind
  customKind        String?
  userAddress       String?
  companionAddress  String?
  personality       String[]
  speakingStyle     String
  background        String?
  boundaries        String?
  immersionEnabled  Boolean             @default(true)
  proactiveMessagesEnabled Boolean       @default(true)
  proactiveFrequencyPreset String        @default("1m")
  proactiveFrequencyMinutes Int          @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  memories          Memory[]
  relationshipState RelationshipState?
  proactiveMessages ProactiveMessage[]
  safetyEvents      SafetyEvent[]
  modelUsageLogs    ModelUsageLog[]

  dreamWorkspace    DreamWorkspace?

  @@index([userId])
}

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  companionId String
  title       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastMessageAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  messages    Message[]
  messageReadReceipts MessageReadReceipt[]
  modelUsageLogs ModelUsageLog[]

  @@index([userId])
  @@index([companionId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  proactiveMessageId String? @unique
  proactiveMessage ProactiveMessage? @relation(fields: [proactiveMessageId], references: [id], onDelete: SetNull)
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memories       Memory[]      @relation("MemorySourceMessage")
  messageReadReceipts MessageReadReceipt[]
  safetyEvents   SafetyEvent[]
  modelUsageLogs ModelUsageLog[]

  @@index([conversationId, createdAt])
}

model Memory {
  supersededById  String?
  revisions       MemoryRevision[]
  id              String       @id @default(cuid())
  userId          String
  companionId     String
  sourceMessageId String?
  type            MemoryType
  status          MemoryStatus @default(PENDING)
  content         String
  confidence      Float        @default(0.5)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion       Companion    @relation(fields: [companionId], references: [id], onDelete: Cascade)
  sourceMessage   Message?     @relation("MemorySourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, companionId, status])
}

model MemoryRevision {
  id              String    @id @default(cuid())
  userId          String
  memoryId        String
  companionId     String
  kind            String
  before          Json
  after           Json
  relatedMemoryId String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory          Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([userId, memoryId, createdAt])
  @@index([userId, companionId])
}

model RelationshipState {
  id                 String    @id @default(cuid())
  userId             String
  companionId        String    @unique
  familiarityScore   Int       @default(0)
  closenessScore     Int       @default(0)
  recentEmotion      String?
  importantEvents    Json?
  lastInteractionAt  DateTime?
  explanation        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion          Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProactiveMessage {
  id          String                 @id @default(cuid())
  deliveryKey String?                @unique
  message     Message?
  userId      String
  companionId String
  kind        ProactiveMessageKind   @default(DAILY_GREETING)
  content     String
  reason      String?
  safety      Json?
  status      ProactiveMessageStatus @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion   Companion              @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([companionId])
}

model SafetyEvent {
  id          String          @id @default(cuid())
  userId      String
  companionId String?
  messageId   String?
  type        SafetyEventType
  action      String
  stage       String
  severity    String
  contentHash String
  riskHash    String
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion   Companion?      @relation(fields: [companionId], references: [id], onDelete: SetNull)
  message     Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([riskHash])
}

model ModelUsageLog {
  id               String   @id @default(cuid())
  userId           String
  companionId      String?
  conversationId   String?
  messageId        String?
  purpose          String
  provider         String
  model            String
  status           String
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs        Int?
  errorKind        String?
  httpStatus       Int?
  fallbackReason   String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion        Companion? @relation(fields: [companionId], references: [id], onDelete: SetNull)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message          Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([provider, model])
  @@index([status, createdAt])
}

model ProviderCredential {
  id                String   @id @default(cuid())
  userId            String
  kind              String
  provider          String
  baseUrl           String?
  model             String?
  encryptedApiKey   String
  keyIv             String
  keyAuthTag        String
  keyFingerprint    String
  keyPreview        String
  encryptionVersion String   @default("aes-256-gcm:v1")
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, status])
}

// Bounded dream snapshots contain isolated rounds, confirmed fragments and profile versions.
model DreamWorkspace {
  id          String    @id
  userId      String
  companionId String    @unique
  revision    Int
  state       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Group snapshots and durable reply claims are isolated from private conversations.
model GroupWorkspace {
  id        String   @id
  userId    String
  revision  Int
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageReadReceipts MessageReadReceipt[]

  @@index([userId])
}

// Explicit seen IDs only; never advance a time-based read watermark.
model MessageReadReceipt {
  userId           String
  scope            String
  threadId         String
  messageId        String
  conversationId   String?
  groupId          String?
  privateMessageId String?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  group            GroupWorkspace? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  privateMessage   Message?      @relation(fields: [privateMessageId], references: [id], onDelete: Cascade)

  @@id([userId, scope, threadId, messageId])
  @@index([conversationId])
  @@index([groupId])
  @@index([privateMessageId])
}
