    {
      "id": "safety",
      "name": "内容安全和错误脱敏",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "safety/check"
      ]
    },
    {
      "id": "presentation",
      "name": "巨钟、光团、开门入梦、音效、静音、跳过、回响录、故事背景、人物预览",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": []
    }
  ]
}
