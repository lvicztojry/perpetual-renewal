{
  "scope": "all-existing-web-features",
  "deliveryRule": "Every feature must pass native simulator and device acceptance before full migration is complete.",
  "features": [
    {
      "id": "auth",
      "name": "注册、验证邮箱、登录、找回和重置密码、退出",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "auth/register",
        "auth/verify-email",
        "auth/login",
        "auth/forgot-password",
        "auth/reset-password",
        "auth/logout"
      ]
    },
    {
      "id": "profile",
      "name": "个人资料、偏好、删除账号",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "me",
        "me/account"
      ]
    },
    {
      "id": "companions",
      "name": "人物创建、编辑、删除、所有关系类型、初始人物",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "companions",
        "companions/[companionId]",
        "starters"
      ]
    },
    {
      "id": "imports",
      "name": "聊天文件解析、抽样选择、人物提炼、试聊确认、结构化导入",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "character-import",
        "companions/[companionId]/imports",
        "chat/complete"
