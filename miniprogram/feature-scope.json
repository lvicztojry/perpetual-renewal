      "routes": [
        "me/llm-credential",
        "me/llm-models",
        "me/llm-test",
        "me/config-status"
      ]
    },
    {
      "id": "voice",
      "name": "录音、转写、语音合成、播放、语言适配",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "voice/transcribe",
        "voice/synthesize"
      ]
