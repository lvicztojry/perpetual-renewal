    {
      "id": "dream",
      "name": "入梦、草稿、候选、反馈、试聊、应用预览、确认、冲突、版本恢复",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "companions/[companionId]/dream"
      ]
    },
    {
      "id": "memories",
      "name": "记忆候选、确认、纠错、替代、归档、遗忘、分页历史",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "companions/[companionId]/memories",
        "memories/[memoryId]",
        "memories/[memoryId]/history"
      ]
    },
    {
      "id": "relationship",
      "name": "关系状态展示",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "companions/[companionId]/relationship-state"
      ]
    },
    {
      "id": "proactive",
      "name": "私聊和群聊主动开关、频率、草稿、确认、调度",
      "status": "implemented-awaiting-manual-wechat-validation",
      "routes": [
        "companions/[companionId]/proactive-drafts",
        "proactive-messages/[proactiveMessageId]",
