page{background:#131714;color:#ece4d3;font-family:-apple-system,"Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.65}
view,input,textarea,button{box-sizing:border-box}
button{margin:22rpx 0;padding:12rpx 26rpx;min-height:76rpx;background:linear-gradient(125deg,#c7ac76,#aa8a53);color:#1c2119;border:1rpx solid #ddbf8880;border-radius:4rpx;font-size:28rpx;font-weight:400;line-height:1.8;letter-spacing:2rpx}
button::after{border:0}button[disabled]{opacity:.45;color:#c5bda7;background:#4b4636}input,textarea{width:100%;padding:22rpx 24rpx;background:#101610b3;border:1rpx solid #b89a663b;color:#ece4d3;border-radius:4rpx;margin:18rpx 0;font-size:30rpx;line-height:1.8}input{height:92rpx}textarea{min-height:130rpx}
.page{padding:36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));min-height:100vh;background:radial-gradient(ellipse at 100% 0,#67503519,transparent 65%),#191d19}
.title,.section{font-family:"Songti SC",SimSun,serif;font-weight:400;letter-spacing:4rpx;color:#f0e3cd}.title{font-size:44rpx;margin:10rpx 0 24rpx}.section{font-size:34rpx;margin:40rpx 0 20rpx}.note{color:#aaa28e;font-size:26rpx;line-height:1.8}.error{color:#d4a38f;font-size:26rpx;white-space:pre-wrap;margin:14rpx 0}.card{padding:26rpx;margin:24rpx 0;background:linear-gradient(135deg,#b89a6609,transparent),#1b201b;border:1rpx solid #b89a663b;border-radius:4rpx}.plain{white-space:pre-wrap;line-height:1.95}.small{font-size:26rpx}.selected{border-color:#b89a66}.danger{background:transparent;color:#d4a38f;border-color:#d4a38f66}.row{display:flex;flex-wrap:wrap;align-items:center;gap:12rpx}.row button{width:auto;min-width:0;min-height:66rpx;flex:0 0 auto;margin:6rpx 0;padding:10rpx 20rpx;background:transparent;color:#cdb98d;border:1rpx solid #b89a6640;font-size:26rpx;line-height:1.6}.badge{display:inline-block;background:#b89a66;color:#171c16;padding:0 12rpx;border-radius:40rpx;font:24rpx/40rpx monospace}.date{color:#a99b80;font:22rpx/1.7 monospace;margin:16rpx 0}.avatar{display:flex;align-items:center;justify-content:center;width:72rpx;height:78rpx;flex-shrink:0;color:#dac49b;border:1rpx solid #b89a6655;background:linear-gradient(140deg,#71664b55,#242a22);box-shadow:inset 0 0 0 5rpx #161b1660;border-radius:2rpx;font:32rpx "Songti SC",SimSun,serif}.ghost{background:transparent;color:#cdb98d;border-color:#b89a6650}.link{background:transparent!important;border:0!important;color:#bfa984!important;min-height:48rpx!important;padding:8rpx!important;font-size:25rpx!important}.muted{color:#9a9788}.message{margin:30rpx 0;padding:24rpx;border:1rpx solid #b89a6633;border-radius:4rpx;background:#20261fbf;white-space:pre-wrap;line-height:1.95}.message.user{margin-left:70rpx;background:linear-gradient(125deg,#65533380,#39372a99)}.speaker{font-family:"Songti SC",SimSun,serif;color:#d7c298;margin-bottom:12rpx}checkbox-group label,radio-group label{display:inline-flex;align-items:center;margin:12rpx 20rpx 12rpx 0;color:#bcae91;font-size:26rpx}radio,checkbox{transform:scale(.8)}
.conversation-page{position:relative;display:flex;flex-direction:column;height:100vh;min-height:0;overflow:hidden;padding:0;background:#191d19}.chat-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.12;pointer-events:none}.conversation-head{position:relative;z-index:1;flex-shrink:0;padding:24rpx 26rpx 18rpx;border-bottom:1rpx solid #b89a663b;background:#191e18ed}.head-title{display:flex;align-items:center;gap:20rpx;min-width:0}.head-name{font:38rpx/1.4 "Songti SC",SimSun,serif;letter-spacing:3rpx;color:#f0e3cd;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.head-copy{min-width:0;flex:1}.head-sub{color:#bfa984;font-size:22rpx;margin-top:6rpx}.toolbar{display:flex;gap:14rpx;flex-wrap:wrap;align-items:center;margin:14rpx 0 0 86rpx}.toolbar button{margin:0;padding:8rpx 14rpx;min-height:54rpx;width:auto;background:transparent;border:1rpx solid #b89a6655;color:#cdb98d;font-size:24rpx;line-height:1.5}.toolbar .link{min-width:0}.conversation-page .history{position:relative;z-index:1;flex:1;height:0!important;min-height:0}.history-content{padding:24rpx 24rpx 50rpx}.conversation-page .message{background:transparent;border:0;margin:26rpx 0 38rpx;padding:0 0 0 72rpx;position:relative;white-space:normal}.message .message-avatar{position:absolute;left:0;top:12rpx;width:54rpx;height:60rpx;font-size:25rpx}.message-body{padding:3rpx 0 12rpx 22rpx;border-left:1rpx solid #b89a6655;white-space:pre-wrap;line-height:1.95;font-size:30rpx}.conversation-page .message.user{margin-left:72rpx;padding:0}.message.user .message-body{margin-left:auto;display:table;max-width:100%;padding:22rpx 26rpx;background:linear-gradient(125deg,#65533380,#39372a99);border:1rpx solid #b89a6644;border-radius:3rpx}.message.user .date{text-align:right}.message .row{gap:18rpx;margin-top:10rpx}.message .row button{background:transparent;border:0;color:#979581;padding:2rpx 4rpx;min-height:44rpx;margin:0;font-size:23rpx;letter-spacing:0}.message .row .is-important{color:#ddbf88}.composer{position:relative;z-index:2;flex-shrink:0;padding:14rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:linear-gradient(0deg,#141914,#191d19f5);border-top:1rpx solid #b89a663b}.composer-caption{display:flex;justify-content:space-between;color:#a99b80;font-size:21rpx;letter-spacing:1rpx;margin:0 0 12rpx}.compose-row{display:flex;align-items:flex-end;gap:14rpx}.compose-row textarea{flex:1;min-width:0;min-height:96rpx;max-height:220rpx;margin:0;padding:20rpx;font-size:28rpx}.compose-row button{margin:0;flex-shrink:0;padding:14rpx;min-height:92rpx;font-size:25rpx;min-width:82rpx;letter-spacing:1rpx}.compose-row .mic{background:transparent;border:0;color:#bcae91;min-width:50rpx;padding:8rpx;font-size:24rpx}.conversation-status{position:relative;z-index:2;font-size:24rpx;color:#d4a38f;max-height:100rpx;overflow:auto;padding:0 24rpx;background:#171c17}.sheet-shade{position:fixed;z-index:9;inset:0;background:#080b08bb}.sheet{position:absolute;right:0;top:0;bottom:0;width:94%;padding:30rpx;background:linear-gradient(145deg,#2f302366,transparent 40%),#1b1f1b;border-left:1rpx solid #b89a6666}.sheet-header{display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #b89a663b;margin-bottom:24rpx}.sheet-header .title{font-size:35rpx}.sheet-header button{margin:0 0 20rpx}.sheet-scroll{height:calc(100% - 100rpx)}
.compose-row button{width:92rpx;flex:0 0 92rpx;min-width:92rpx;padding:12rpx 8rpx}.compose-row .mic{width:62rpx;flex:0 0 62rpx;min-width:62rpx;padding:8rpx 0}.compose-row textarea{width:0;flex:1 1 0}.head-title>button{width:72rpx;flex:0 0 72rpx;min-width:72rpx;min-height:68rpx;margin:0;padding:10rpx 0}.head-title>.link{width:62rpx;min-width:62rpx;flex-basis:62rpx}
.head-title>.link{width:90rpx;min-width:90rpx;flex-basis:90rpx;white-space:nowrap}.toolbar button{white-space:nowrap}
