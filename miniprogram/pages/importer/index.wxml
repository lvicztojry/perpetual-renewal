<view class="page"><view class="title">从聊天记录创建人物</view><view class="note">原文件仅在本机解析，只有你勾选的双方样本会被提交。</view><button bindtap="chooseFile">选择 TXT / JSON / JSONL 文件</button><textarea value="{{text}}" data-field="text" bindinput="input" maxlength="200000" auto-height placeholder="或粘贴导出的文本" /><button bindtap="parse" disabled="{{busy}}">在本地解析</button><picker range="{{participants}}" range-key="name" bindchange="target"><view>对方：{{target || '请选择'}}</view></picker><picker range="{{participants}}" range-key="name" bindchange="self"><view>我：{{self || '请选择'}}</view></picker><button bindtap="sample" disabled="{{busy}}">生成本地抽样预览</button>
<view wx:for="{{sample}}" wx:key="key" class="card"><switch checked="{{item.selected}}" data-index="{{index}}" bindchange="toggle" /><view>{{item.speaker}}：{{item.content}}</view></view><button wx:if="{{sample.length}}" bindtap="analyze" disabled="{{busy}}" loading="{{busy}}">提炼已勾选样本</button><view wx:for="{{warnings}}" wx:key="*this" class="note">{{item}}</view>
<view wx:if="{{draft}}"><fields schema="{{schema}}" values="{{form}}" bind:edit="edit" disabled="{{busy}}" /><view wx:for="{{history}}" wx:key="index" class="message">{{item.role === 'user' ? '我' : form.name}}：{{item.content}}</view><input value="{{previewText}}" data-field="previewText" bindinput="input" placeholder="先试聊一句" /><button bindtap="preview" disabled="{{busy}}">试聊</button><button bindtap="create" disabled="{{busy}}">确认并创建人物</button></view><view class="error">{{error}}</view><view class="note">{{notice}}</view></view>
