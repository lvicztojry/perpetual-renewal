<view class="page conversation-page"><image class="chat-bg" src="/assets/chat-room.webp" mode="aspectFill" />
 <view class="conversation-head"><view class="head-title"><view class="avatar">{{person.name[0]}}</view><view class="head-copy"><view class="head-name">{{person.name}}</view><view class="head-sub">此刻的回响</view></view></view><view class="toolbar"><button bindtap="open" data-page="dream">☾ 入梦</button><button class="link" bindtap="open" data-page="companion">人物</button><button class="link" bindtap="open" data-page="memories">记忆</button><button class="link" bindtap="toggleProactive">回响</button><button class="link" bindtap="refreshNow" disabled="{{busy}}">刷新</button></view></view>
 <scroll-view class="history" scroll-y enhanced><view class="history-content"><view wx:for="{{messages}}" wx:key="id" class="message {{item.role}} {{item.role === 'assistant' && !item.failed ? 'incoming' : ''}}" data-id="{{item.id}}"><view wx:if="{{item.role === 'assistant'}}" class="avatar message-avatar">{{person.name[0]}}</view><view class="date">{{item.role === 'user' ? '我 · ' : ''}}{{item.time}} {{item.important ? '★' : ''}}</view><view class="message-body"><text selectable>{{item.content}}</text></view><view wx:if="{{item.failed}}" class="error">回复失败，可以重试。</view><view class="row"><button wx:if="{{item.role === 'assistant'}}" bindtap="messageAction" data-id="{{item.id}}" data-action="regenerate" disabled="{{busy}}">↶ 重回应</button><button wx:if="{{item.role === 'assistant'}}" class="{{item.important ? 'is-important' : ''}}" bindtap="messageAction" data-id="{{item.id}}" data-action="set_important" disabled="{{busy}}">{{item.important ? '★ 已重要' : '☆ 重要'}}</button><button bindtap="speak" data-id="{{item.id}}" disabled="{{busy}}">♫ 朗读</button><button bindtap="messageAction" data-id="{{item.id}}" data-action="delete" disabled="{{busy}}">删除</button></view></view><view wx:if="{{busy}}" class="note">对方正在回应…</view></view></scroll-view>
 <view wx:if="{{error || notice}}" class="conversation-status">{{error || notice}}</view>
 <view class="composer"><view class="composer-caption"><text>说给{{person.name}}</text><text>念念不忘，必有回响</text></view><view class="compose-row"><button wx:if="{{!recording}}" class="mic" bindtap="record" disabled="{{busy}}">录音</button><textarea value="{{draft}}" data-field="draft" bindinput="input" maxlength="8000" disabled="{{busy}}" auto-height placeholder="把想说的话放在这里" /><button bindtap="send" disabled="{{busy || recording}}" loading="{{busy}}">发送</button></view><view wx:if="{{recording || playing}}" class="row"><button wx:if="{{recording}}" bindtap="stopRecord">结束并转写</button><button wx:if="{{recording}}" bindtap="cancelRecord">取消录音</button><button wx:if="{{playing}}" bindtap="stopAudio">停止播放</button></view></view>
 <view wx:if="{{showProactive}}" class="sheet-shade"><view class="sheet"><view class="sheet-header"><view class="title">主动回响</view><button class="link" bindtap="toggleProactive">关闭</button></view><scroll-view class="sheet-scroll" scroll-y><view class="note">{{availability.effectiveEnabled ? '主动回响已开启' : '主动回响暂停，可在人物和账号设置中调整'}}</view><radio-group bindchange="filterProactive"><label><radio value="all" checked />全部</label><label><radio value="draft" />草稿</label><label><radio value="sent" />已发送</label><label><radio value="dismissed" />已忽略</label><label><radio value="blocked" />已阻止</label></radio-group><view wx:for="{{proactive}}" wx:key="id"><view wx:if="{{proactiveFilter === 'all' || proactiveFilter === item.status}}" class="card"><view class="note">{{item.status}} · {{item.scheduledAt}}</view><view class="plain">{{item.content}}</view><view class="note">{{item.reason}} {{item.safety.reason}}</view><view class="row"><button wx:if="{{item.status === 'draft'}}" bindtap="proactive" data-id="{{item.id}}" data-status="sent" disabled="{{busy}}">接收回响</button><button wx:if="{{item.status === 'draft'}}" bindtap="proactive" data-id="{{item.id}}" data-status="dismissed" disabled="{{busy}}">忽略</button><button wx:if="{{item.status === 'draft'}}" bindtap="proactive" data-id="{{item.id}}" data-status="blocked" disabled="{{busy}}">阻止</button></view></view></view><button bindtap="generateProactive" disabled="{{busy}}">生成一条回响草稿</button></scroll-view></view></view>
</view>
