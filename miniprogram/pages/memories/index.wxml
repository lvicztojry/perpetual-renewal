<view class="page"><view class="title">长期记忆</view><button bindtap="fresh">建立候选</button>
<view wx:for="{{memories}}" wx:key="id" class="card"><view class="note">{{item.status}} · {{item.type}}</view><view class="plain">{{item.content}}</view><button bindtap="select" data-id="{{item.id}}">编辑与变更记录</button></view>
<view class="section">{{selected ? '编辑记忆' : '新记忆候选'}}</view><fields schema="{{schema}}" values="{{form}}" disabled="{{busy}}" bind:edit="edit" /><button bindtap="save" disabled="{{busy}}">{{selected ? '保存' : '建立候选（需另行确认）'}}</button>
<view wx:if="{{selected}}"><button bindtap="forget" class="danger" disabled="{{busy}}">遗忘</button><button bindtap="history" disabled="{{busy}}">{{cursor ? '加载更多变更' : '查看变更记录'}}</button><view wx:for="{{history}}" wx:key="id" class="card"><view>{{item.createdAt}} · {{item.kind}}</view><view>原内容：{{item.before.content}}</view><view>新内容：{{item.after.content}}</view><view>{{item.before.status}} → {{item.after.status}}</view></view>
<view wx:if="{{selected.status === 'active'}}" class="card"><picker range="{{memories}}" range-key="content" bindchange="replacement"><view>选择替代事实：{{replacementId || '请选择'}}</view></picker><button bindtap="supersede" disabled="{{busy}}">用所选事实替代</button></view></view>
<view class="section">导入资料</view><radio-group bindchange="mode"><label><radio value="text" checked />单段</label><label><radio value="batch" />分段批量（空行分隔）</label><label><radio value="jsonl" />JSONL</label></radio-group><radio-group bindchange="source"><label><radio value="memory_candidate" checked />记忆候选</label><label><radio value="tone_sample" />语气样例</label><label><radio value="material" />背景资料</label></radio-group><button bindtap="chooseFile">从微信文件读取</button><textarea value="{{importText}}" data-field="importText" bindinput="input" maxlength="200000" auto-height /><button bindtap="importMemories" disabled="{{busy}}">导入为待确认候选</button><view class="error">{{error}}</view><view class="note">{{notice}}</view></view>
