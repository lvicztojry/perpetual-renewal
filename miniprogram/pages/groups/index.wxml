<view class="page {{group && !editing ? 'conversation-page' : ''}}">
<view wx:if="{{!group}}"><view class="title">围坐 · 群聊</view><view class="note">留盏灯，一起聊聊。</view><button wx:for="{{groups}}" wx:key="id" class="ghost" data-page="groups" data-id="{{item.id}}" bindtap="go">{{item.name}}</button><view class="section">创建群聊</view><fields schema="{{schema}}" values="{{form}}" bind:edit="edit" disabled="{{busy}}" /><checkbox-group bindchange="selectMembers"><label wx:for="{{people}}" wx:key="id"><checkbox value="{{item.id}}" />{{item.name}}</label></checkbox-group><button bindtap="save" disabled="{{busy}}">创建</button></view>
<view wx:elif="{{editing}}"><view class="title">成员与设置</view><fields schema="{{schema}}" values="{{form}}" bind:edit="edit" disabled="{{busy}}" /><view wx:for="{{members}}" wx:key="companionId" class="card"><view class="section">{{item.name}}</view><view>加入群聊 <switch checked="{{item.selected}}" data-index="{{index}}" data-key="selected" bindchange="memberChange" color="#b89a66" /></view><view>允许使用其私聊记忆 <switch checked="{{item.allowPrivateMemories}}" data-index="{{index}}" data-key="allowPrivateMemories" bindchange="memberChange" color="#b89a66" /></view><view>允许主动发言 <switch checked="{{item.proactiveEnabled}}" data-index="{{index}}" data-key="proactiveEnabled" bindchange="memberChange" color="#b89a66" /></view><input value="{{item.relationship}}" data-index="{{index}}" data-key="relationship" bindinput="memberChange" placeholder="群内关系说明" /></view><button bindtap="save" disabled="{{busy}}">保存设置</button><button class="ghost" bindtap="cancelEdit" disabled="{{busy}}">取消</button></view>
<block wx:else><image class="chat-bg" src="/assets/chat-room.webp" mode="aspectFill" /><view class="conversation-head"><view class="head-title"><view class="head-copy"><view class="head-name">{{group.name}}</view><view class="head-sub" bindtap="togglePanel" data-field="showBackground">{{showBackground ? '▾' : '▸'}} {{group.members.length}} 位成员 · 群简介</view></view><button class="link" bindtap="togglePanel" data-field="showMemory">记忆</button><button class="ghost" bindtap="editGroup" disabled="{{busy}}">⚙</button></view><view wx:if="{{showBackground}}"><view class="plain note">{{group.background}}</view><view class="row"><button bindtap="refreshNow" disabled="{{busy}}">刷新</button><button bindtap="exportGroup">导出群聊</button><button bindtap="remove" class="danger" disabled="{{busy}}">删除群聊</button></view></view></view>
<scroll-view class="history" scroll-y><view class="history-content"><view wx:for="{{group.messages}}" wx:key="id" class="message {{item.speakerId ? 'assistant incoming' : 'user'}}" data-id="{{item.id}}"><view wx:if="{{item.speakerId}}" class="avatar message-avatar">{{item.name[0]}}</view><view class="date">{{item.name}} · {{item.createdAt}}</view><view class="message-body"><text selectable>{{item.content}}</text></view></view></view></scroll-view>
<view wx:if="{{error || notice}}" class="conversation-status">{{error || notice}}</view><view class="composer"><view class="composer-caption"><text bindtap="togglePanel" data-field="showMentions">@ 选择成员 {{mentions.length ? '· ' + mentions.length + ' 位' : ''}}</text><text bindtap="proactive">邀请主动发言</text></view><view class="compose-row"><textarea value="{{draft}}" data-field="draft" bindinput="input" maxlength="8000" auto-height placeholder="说点什么，让灯下热闹起来…" /><button bindtap="send" loading="{{busy}}" disabled="{{busy}}">发送</button></view><button wx:if="{{progress.speakers.length}}" class="link" bindtap="resume" disabled="{{busy}}">恢复本轮接话</button></view>
<view wx:if="{{showMentions}}" class="sheet-shade"><view class="sheet"><view class="sheet-header"><view class="title">选择发言人物</view><button class="link" bindtap="togglePanel" data-field="showMentions">完成</button></view><checkbox-group bindchange="selectMentions"><view wx:for="{{groupPeople}}" wx:key="id" class="card"><label><checkbox value="{{item.id}}" />{{item.name}}</label></view></checkbox-group></view></view>
<view wx:if="{{showMemory}}" class="sheet-shade"><view class="sheet"><view class="sheet-header"><view class="title">共同记忆</view><button class="link" bindtap="togglePanel" data-field="showMemory">关闭</button></view><scroll-view class="sheet-scroll" scroll-y><view wx:for="{{group.memories}}" wx:key="id" class="card"><view>{{item.content}}</view><button class="link" bindtap="forget" data-id="{{item.id}}" disabled="{{busy}}">删除记忆</button></view><view class="section">选取来源消息</view><checkbox-group bindchange="selectSources"><view wx:for="{{group.messages}}" wx:key="id" class="card"><checkbox value="{{item.id}}" /><text>{{item.name}}：{{item.content}}</text></view></checkbox-group><textarea value="{{memoryText}}" data-field="memoryText" bindinput="input" placeholder="确认的共同经历" auto-height /><view class="note">知情人物（只选择当时在群里的人）</view><checkbox-group bindchange="selectKnown"><label wx:for="{{groupPeople}}" wx:key="id"><checkbox value="{{item.id}}" />{{item.name}}</label></checkbox-group><button bindtap="remember" disabled="{{busy}}">确认共同记忆</button></scroll-view></view></view>
</block><view wx:if="{{!group || editing}}"><view class="error">{{error}}</view><view class="note">{{notice}}</view></view></view>
