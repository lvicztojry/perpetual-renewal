<view class="page"><view class="title">账号与设置</view><fields schema="{{schema}}" values="{{form}}" bind:edit="edit" disabled="{{busy}}" /><button bindtap="saveProfile" disabled="{{busy}}">保存资料</button>
<view class="section">模型连接</view><view class="note">{{credential.configured ? '已配置凭据' : '尚未配置凭据'}}。接口地址不回显，留空保留已保存地址。真实连接测试和聊天可能消耗供应商额度。</view><fields schema="{{modelSchema}}" values="{{model}}" bind:edit="editModel" disabled="{{busy}}" /><button bindtap="saveModel" disabled="{{busy}}">加密保存</button><button bindtap="models" disabled="{{busy}}">读取模型列表</button><picker wx:if="{{models.length}}" range="{{models}}" range-key="id" bindchange="chooseModel"><view>从模型列表选择</view></picker><button bindtap="test" disabled="{{busy}}">测试当前配置（先保存 Key）</button><button bindtap="deleteModel" class="danger" disabled="{{busy}}">删除凭据</button>
<view class="section">配置状态</view><view wx:for="{{status}}" wx:key="index" class="card small">{{item.label}}：{{item.value}}</view>
<view class="section">用量统计</view><input type="number" value="{{range}}" data-field="range" bindinput="input" placeholder="最近天数（1—90）" /><button bindtap="usage" disabled="{{busy}}">更新统计</button><view wx:for="{{usage}}" wx:key="index" class="small">{{item.label}}：{{item.value}}</view><button bindtap="exportData" disabled="{{busy}}">导出完整账号数据</button>
<view class="section">删除账号</view><input value="{{confirmation}}" data-field="confirmation" bindinput="input" placeholder="输入：删除我的账号" /><button bindtap="deleteAccount" class="danger" disabled="{{busy}}">永久删除账号</button><view class="error">{{error}}</view><view class="note">{{notice}}</view></view>
