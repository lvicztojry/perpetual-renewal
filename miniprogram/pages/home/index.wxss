.home-page{min-height:100vh;background:#111611;padding-bottom:env(safe-area-inset-bottom)}.masthead{height:470rpx;position:relative;overflow:hidden;border-bottom:1rpx solid #b89a6670;background:#1d231c}.hero-scene{position:absolute;inset:0;width:100%;height:100%;opacity:.88}.hero-bell{position:absolute;top:-80rpx;left:-110rpx;width:940rpx;height:610rpx}.hero-shade{position:absolute;inset:0;background:linear-gradient(0deg,#111611 0%,#111611c9 20%,#1116110a 78%)}.masthead-note{position:absolute;left:46rpx;top:40rpx;color:#f2dcc1;font:21rpx "Songti SC",SimSun,serif;letter-spacing:5rpx}.brand{position:absolute;bottom:44rpx;left:44rpx;display:flex;align-items:center;gap:22rpx}.emblem{font:78rpx "Songti SC",serif;color:#d6bb80;line-height:1}.brand-name{font:60rpx/1.3 "Songti SC",SimSun,serif;letter-spacing:9rpx;color:#f0e3cd}.brand-sub{font-size:21rpx;color:#c7b68e;letter-spacing:4rpx;margin-top:14rpx}.contacts{padding:28rpx 30rpx 36rpx}.contact-heading{display:flex;justify-content:space-between;align-items:center;margin:10rpx 20rpx 24rpx;color:#cbb486;font:28rpx "Songti SC",SimSun,serif;letter-spacing:3rpx}.count{font:20rpx monospace;letter-spacing:0}.contact{display:flex;align-items:center;gap:24rpx;padding:26rpx 24rpx;min-height:156rpx;border-left:3rpx solid transparent;border-bottom:1rpx solid #b89a661a}.contact:active{background:linear-gradient(90deg,#b89a6622,#b89a6604);border-left-color:#b89a66}.contact-copy{flex:1;min-width:0}.contact-name{font:36rpx "Songti SC",SimSun,serif;letter-spacing:2rpx;color:#eee0bd}.contact-preview{font-size:25rpx;color:#aaa798;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;margin-top:10rpx}.quick-actions{border-top:1rpx solid #b89a663d;margin:70rpx 12rpx 0;padding-top:32rpx}.nav-link{text-align:left;display:flex;align-items:center;gap:18rpx;background:transparent;color:#c6b58b;border:0;font-size:27rpx;min-height:84rpx;margin:6rpx 0;padding:12rpx 14rpx;letter-spacing:1rpx}.nav-icon{font-size:34rpx;color:#9b947b;width:38rpx;line-height:1}.primary-nav{border:1rpx solid #b89a6666;background:linear-gradient(110deg,#b89a661a,transparent);margin:12rpx 0 20rpx}.group-list{margin-top:34rpx}.empty-note{padding:32rpx 20rpx;color:#aaa28e;font-size:27rpx}.empty-note view{font-size:24rpx;margin-top:10rpx}.login-content{padding:42rpx 44rpx}.login-heading{font:40rpx "Songti SC",SimSun,serif;letter-spacing:4rpx;color:#e5d3aa;margin-bottom:18rpx}.login-form{margin-top:34rpx}.field-caption{font-size:25rpx;color:#b9aa8a;letter-spacing:3rpx;margin-top:22rpx}.login-submit{margin-top:34rpx;letter-spacing:6rpx}.login-links{display:flex;justify-content:space-between}.login-links button{margin:0}.secondary-links{justify-content:center;border-top:1rpx solid #b89a6629;margin-top:24rpx;padding-top:18rpx}.home-status{padding:0 42rpx}
.hero-scene,.hero-bell{top:-8rpx;left:-86rpx;width:1020rpx;height:574rpx}.hero-bell{transform:scale(.85);transform-origin:33% 0}.emblem{position:relative;width:62rpx;height:90rpx}.bell-crown{position:absolute;top:18rpx;left:12rpx;width:38rpx;height:44rpx;border:2rpx solid #d6bb80;border-radius:24rpx 24rpx 4rpx 4rpx}.bell-foot{position:absolute;left:5rpx;top:68rpx;width:52rpx;border-top:2rpx solid #d6bb80}.bell-clapper{position:absolute;left:27rpx;top:74rpx;width:9rpx;height:9rpx;border:2rpx solid #d6bb80;border-radius:50%}
