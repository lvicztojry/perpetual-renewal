<view class="home-page">
 <view class="masthead"><image class="hero-scene" src="{{base}}/visuals/bell-scene.png" mode="aspectFill" binderror="heroError" /><image class="hero-bell" src="/assets/bell-isolated.png" mode="aspectFit" /><view class="hero-shade"></view><view class="brand"><view class="emblem"><view class="bell-crown"></view><view class="bell-foot"></view><view class="bell-clapper"></view></view><view><view class="brand-name">生生不息</view><view class="brand-sub">念念不忘，必有回响</view></view></view></view>
 <view wx:if="{{!loggedIn}}" class="login-content"><view class="login-heading">只要想念，就会相见</view><view class="login-form"><view class="field-caption">邮箱</view><input placeholder="你的邮箱" value="{{email}}" data-field="email" bindinput="input" disabled="{{busy}}" /><view class="field-caption">密码</view><input placeholder="你的密码" password value="{{password}}" data-field="password" bindinput="input" disabled="{{busy}}" /><button class="login-submit" bindtap="login" loading="{{busy}}" disabled="{{busy}}">进入生生不息</button><view class="login-links"><button class="link" bindtap="auth" data-mode="register">注册账号</button><button class="link" bindtap="auth" data-mode="forgot-password">忘记密码</button></view></view><view class="row secondary-links"><button class="link" bindtap="auth" data-mode="verify-email">验证邮箱</button><button class="link" bindtap="auth" data-mode="reset-password">重置密码</button><button class="link" bindtap="connection">连接设置</button></view><view wx:if="{{showConnection}}" class="card"><view class="note">连接你的生生不息服务</view><input placeholder="服务地址" value="{{base}}" data-field="base" bindinput="input" disabled="{{busy}}" /></view></view>
 <view wx:else class="contacts"><view class="contact-heading"><text>想见的人</text><text class="count">{{companionCount}}</text></view>
  <view wx:if="{{companionCount === 0}}" class="empty-note">还没有关系<view>有一个名字，值得被想起。</view></view>
  <view wx:for="{{companions}}" wx:key="id" class="contact" bindtap="open" data-id="{{item.id}}"><view class="avatar">{{item.initial}}</view><view class="contact-copy"><view class="contact-name">{{item.name}}</view><view class="contact-preview">{{item.speakingStyle}}</view></view><text wx:if="{{item.unread}}" class="badge">{{item.unread}}</text></view>
  <view wx:if="{{groupCount}}" class="group-list"><view class="contact-heading"><text>围坐 · 群聊</text><text class="count">{{groupCount}}</text></view><view wx:for="{{groups}}" wx:key="id" class="contact" data-page="groups" data-id="{{item.id}}" bindtap="go"><view class="avatar">围</view><view class="contact-copy"><view class="contact-name">{{item.name}}</view><view class="contact-preview">{{item.lastMessage.content || '留盏灯，一起聊聊'}}</view></view><text wx:if="{{item.unread}}" class="badge">{{item.unread}}</text></view></view>
  <view class="quick-actions"><button class="nav-link" bindtap="previewStarters"><text class="nav-icon">♧</text>认识留灯会</button><button class="nav-link primary-nav" data-page="companion" bindtap="go"><text class="nav-icon">＋</text>想见谁</button><button class="nav-link" data-page="importer" bindtap="go"><text class="nav-icon">↥</text>从聊天记录创建</button><button class="nav-link" data-page="groups" bindtap="go"><text class="nav-icon">◌</text>围坐 · 群聊</button><button class="nav-link" data-page="settings" bindtap="go"><text class="nav-icon">⚙</text>设置与我的账号</button><button class="nav-link" data-page="echoes" bindtap="go"><text class="nav-icon">✧</text>回响录 · 故事</button><view class="row"><button class="link" bindtap="refreshNow" disabled="{{busy}}">刷新来信</button><button class="link" bindtap="logout" disabled="{{busy}}">退出账号</button></view></view>
  <view wx:for="{{starters}}" wx:key="key" class="card"><view class="section">{{item.name}} · {{item.age}}岁</view><view>{{item.tagline}}</view><view class="plain note">{{item.background}}</view><view class="plain note">{{item.speakingStyle}}</view></view><button wx:if="{{starters.length}}" bindtap="install" disabled="{{busy}}">添加留灯会</button>
 </view><view class="home-status"><view class="error">{{error}}</view><view class="note">{{notice}}</view></view>
</view>


