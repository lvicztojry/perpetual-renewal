.scene{height:65vh;position:relative;overflow:hidden;background:radial-gradient(ellipse at center,#34473c,#07100e 70%);margin:30rpx -28rpx}.halo{position:absolute;left:25%;top:25%;width:50%;height:40%;border-radius:50%;background:#e8ddac;filter:blur(30rpx);opacity:.05}.bell{position:absolute;top:0;left:15%;width:70%;height:65%;transform-origin:50% 0}.figure{position:absolute;bottom:0;left:26%;width:48%;height:60%;opacity:0}.door{position:absolute;top:0;bottom:0;width:50%;background:#14201c;border:1px solid #9f8d58;opacity:0}.left{left:0}.right{right:0}.caption{position:absolute;bottom:5%;width:100%;text-align:center;color:#eee0b1;font-size:30rpx}.playing .bell{animation:ring 2.15s ease-in-out 2}.playing .halo{animation:glow 6s ease-out}.playing.renewal .figure{animation:appear 6s ease-out forwards}.playing.dream .door{opacity:1;animation:open 6s ease-in forwards}.playing.dream .right{animation-name:open-right}.playing.dream .bell{opacity:.5;animation:ring 2s ease-in-out}.reduced .bell,.reduced .halo,.reduced .door,.reduced .figure{animation-duration:.8s!important}@keyframes ring{0%,100%{transform:rotate(0)}25%{transform:rotate(8deg)}70%{transform:rotate(-5deg)}}@keyframes glow{0%{opacity:.02;transform:scale(.1)}50%{opacity:.65;transform:scale(1.5)}100%{opacity:.12;transform:scale(2)}}@keyframes appear{0%,35%{opacity:0;filter:blur(25rpx)}100%{opacity:1;filter:blur(0)}}@keyframes open{0%,20%{transform:translateX(0)}100%{transform:translateX(-100%)}}@keyframes open-right{0%,20%{transform:translateX(0)}100%{transform:translateX(100%)}}

