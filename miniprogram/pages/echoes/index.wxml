<view class="page"><view class="title">回响录</view><view>静音 <switch checked="{{muted}}" bindchange="mute" /></view><view>减少动态效果 <switch checked="{{reduced}}" bindchange="reduced" /></view><view class="row"><button bindtap="play" data-kind="renewal">生生不息</button><button bindtap="play" data-kind="dream">入梦</button><button bindtap="skip">跳过 / 结束演出</button></view>
<view class="scene {{playing ? 'playing' : ''}} {{kind}} {{reduced ? 'reduced' : ''}}"><view class="halo"></view><image wx:if="{{bell}}" class="bell" src="{{bell}}" mode="aspectFit" /><view class="door left"></view><view class="door right"></view><image wx:if="{{silhouette}}" class="figure" src="{{silhouette}}" mode="aspectFit" /><view class="caption">{{kind === 'dream' ? '入梦 · 在回响中，慢慢靠近' : '生生不息 · 念念不忘，必有回响'}}</view></view>
<view class="section">故事背景</view><view wx:for="{{story}}" wx:key="index" class="{{item.kind === 'p' ? 'plain' : 'section'}}">{{item.text}}</view><view class="note">{{notice}}</view><view class="error">{{error}}</view></view>
