{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "生生不息",
  "version": "0.1.3",
  "identifier": "com.perpetualrenewal.localtest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4177",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "生生不息",
        "width": 1200,
        "height": 820,
        "minWidth": 340,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "iOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "17.0",
      "bundleVersion": "4"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 4
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
