{
  "name": "perpetual-renewal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "e2e": "node tests/e2e/run-e2e.mjs",
    "lint": "eslint .",
    "smoke": "node tests/smoke.mjs",
    "qa:samples": "node tests/qa-samples-smoke.mjs",
    "qa:prompt": "node tests/prompt-builder-smoke.mjs",
    "qa:imports": "node tests/structured-import-smoke.mjs",
    "qa:vault": "node tests/config-vault-security.mjs",
    "qa:logging": "node tests/logging-sanitize-smoke.mjs",
    "qa:response": "node tests/response-safety-smoke.mjs",
    "qa:providers": "node tests/provider-adapters-smoke.mjs",
    "qa:voice": "node tests/voice-shared-llm-smoke.mjs",
    "qa:voice-language": "node tests/voice-transcription-language.mjs",
    "qa:auth": "node tests/auth-backend.mjs && node tests/auth-smtp.mjs && node tests/auth-mail-check.mjs",
    "qa:auth:postgres": "node tests/auth-postgres.mjs",
    "qa:auth-access": "node tests/auth-access.mjs",
    "env:mail": "node scripts/auth-mail-check.mjs",
    "qa:mail-check": "node tests/auth-mail-check.mjs",
    "qa:database-url": "node tests/database-url.mjs",
    "qa:proactive-scheduler": "node tests/proactive-scheduler-pagination.mjs",
    "qa:proactive-cron": "node tests/proactive-cron-contract.mjs",
    "qa:real-provider": "node tests/qa-real-provider.mjs",
    "qa:real-provider:fake": "node tests/qa-real-provider-fake.mjs",
    "pwa:check": "node scripts/pwa-check.mjs",
    "db:smoke": "node scripts/db-smoke.mjs",
    "env:readiness": "node scripts/env-readiness.mjs",
    "env:secrets": "node scripts/generate-env-secrets.mjs",
    "secrets:check": "node scripts/check-env-leaks.mjs",
    "docs:check": "node scripts/docs-consistency.mjs",
    "git:boundary": "node scripts/git-boundary-check.mjs",
    "next:typegen": "node scripts/next-typegen.mjs",
    "typecheck": "npm run next:typegen && tsc --noEmit",
    "prisma:generate": "node scripts/prisma-command.mjs generate",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "prisma:migrate": "node scripts/prisma-command.mjs migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-command.mjs migrate deploy",
    "prisma:seed": "node scripts/prisma-command.mjs db seed",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:pr": "npm run verify:local -- --skip-e2e",
    "verify:release": "node scripts/verify-local.mjs --audit",
    "verify:deploy": "npm run env:readiness -- --strict && npm run qa:proactive-cron && npm run prisma:validate && npm run db:smoke"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "lucide-react": "1.33.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "6.12.0",
    "typescript": "6.0.3"
  }
}
