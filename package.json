    "verify:deploy": "npm run env:readiness -- --strict && npm run qa:proactive-cron && npm run prisma:validate && npm run db:smoke",
    "release:notes": "node scripts/release-notes.mjs --write",
    "release:check": "node scripts/release-notes.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "release:publish": "node scripts/publish-release.mjs"
